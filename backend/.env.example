NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/placementos
JWT_SECRET=your-secure-jwt-secret-here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional: Real-world live job provider integrations
# Obtain free developer credentials from https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key

# Obtain free developer credentials from https://developer.usajobs.gov/
USAJOBS_API_KEY=your_usajobs_api_key
USAJOBS_EMAIL=your_email_for_usajobs_user_agent@example.com

SYNC_INTERVAL_HOURS=24
